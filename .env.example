# ── AgriSetu Environment Variables ─────────────────────────
# Copy this to .env and fill in your values

FLASK_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
SECRET_KEY=change-me-in-production
SESSION_COOKIE_SECURE=false

# Shared AgriSetu MongoDB. Use the same database and users collection as signup.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@farmconnect.jkirgkx.mongodb.net/?retryWrites=true&w=majority&appName=farmconnect
MONGODB_DATABASE=test
MONGODB_USERS_COLLECTION=users
SIGNUP_URL=https://agrisetu-1-f5md.onrender.com/signup

# Used to hash Device IDs before storage. Set a long random value in Render.
DEVICE_ID_PEPPER=change-me-in-production

# Arduino requests still require a server-side ingest secret in addition to Device ID.
ARDUINO_SECRET=change-me-in-production
SENSOR_FRESHNESS_SECONDS=30

# ThingESP (your IoT sensor platform)
THINGESP_USERNAME=Noctum
THINGESP_PROJECT=Agrisetu
THINGESP_TOKEN=bBV87AWa

LOG_LEVEL=INFO
